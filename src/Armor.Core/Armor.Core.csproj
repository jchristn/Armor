<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NuGet audit advisories (NU19xx) are kept visible as warnings but do not fail the build:
      they track transitive-dependency advisories (currently SQLitePCLRaw's bundled SQLite native
      library via Microsoft.Data.Sqlite) that we cannot resolve without a patched upstream release.
      Compiler warnings remain errors. Revisit in the Phase 8 hardening pass to pin a patched
      SQLitePCLRaw once one ships on a stable Microsoft.Data.Sqlite.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Description>Armor engine: configuration, SQLite data layer, content-addressed chunk store, AES-256-GCM cryptography, storage-target abstraction over Blobject, and the backup/restore engines.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blobject.Core" Version="5.0.20" />
    <PackageReference Include="Blobject.Disk" Version="5.0.19" />
    <PackageReference Include="Blobject.AmazonS3" Version="5.0.21" />
    <PackageReference Include="Blobject.AzureBlob" Version="5.0.19" />
    <PackageReference Include="Blobject.CIFS" Version="5.0.20" />
    <PackageReference Include="Blobject.NFS" Version="5.0.20" />
    <PackageReference Include="Blobject.GoogleCloud" Version="5.0.20" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="PrettyId" Version="2.0.1" />
  </ItemGroup>

</Project>
