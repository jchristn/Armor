<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Armor engine: configuration, SQLite data layer, content-addressed chunk store, AES-256-GCM cryptography, storage-target abstraction over Blobject, and the backup/restore engines.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blobject.Core" Version="6.0.0" />
    <PackageReference Include="Blobject.Disk" Version="6.0.0" />
    <PackageReference Include="Blobject.AmazonS3" Version="6.0.0" />
    <PackageReference Include="Blobject.AzureBlob" Version="6.0.0" />
    <PackageReference Include="Blobject.CIFS" Version="6.0.0" />
    <PackageReference Include="Blobject.NFS" Version="6.0.0" />
    <PackageReference Include="Blobject.GoogleCloud" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!--
      Pin the SQLitePCLRaw family to a patched build. Older SQLitePCLRaw 2.1.x releases bundle a
      SQLite native library flagged by NuGet audit (NU1903 / GHSA-2m69-gcr7-jv3q), so this direct
      reference keeps the whole dependency graph on a fixed release. Stay on the 2.1.x line:
      Microsoft.Data.Sqlite 10 is built against SQLitePCLRaw 2.1, and 3.x is a breaking major.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="PrettyId" Version="2.0.1" />
    <PackageReference Include="SyslogLogging" Version="2.2.2" />
  </ItemGroup>

</Project>
