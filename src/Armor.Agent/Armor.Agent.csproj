<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!--
      We author no XAML (the Avalonia app is entirely code), so disable the Avalonia XAML
      compilation task. It otherwise runs for AvaloniaResource items and races on the
      intermediate assembly when the net8.0 and net10.0 targets build in parallel
      (IOException: "the file ... is being used by another process"). The tray icon is
      embedded as a plain resource and loaded from a manifest stream instead.
    -->
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
    <Description>Armor agent: the always-on background process that owns the system-tray icon and runs scheduled backups.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.ico" LogicalName="Armor.Agent.logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Armor.Core\Armor.Core.csproj" />
  </ItemGroup>

</Project>
