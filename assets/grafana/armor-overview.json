    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Armor log lines at warning and above, from every selected process. Lines logged during a backup carry trace_id; expand a line to jump to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$job\"} | detected_level=~\"warn|error|critical\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 12,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "table",
      "title": "Running builds",
      "description": "",
      "datasource": {
        "type": "prometheus",
