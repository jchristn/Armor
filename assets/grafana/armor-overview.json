{
  "uid": "armor-overview",
  "title": "Armor / Overview",
  "description": "One-glance health of Armor backups: freshness, failures, scheduler liveness, errors. Start here.",
  "tags": [
    "armor",
    "overview"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Armor / Backups",
      "type": "link",
      "url": "/d/armor-backups",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Storage & Integrations",
      "type": "link",
      "url": "/d/armor-storage",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Restore, Verify & Retention",
      "type": "link",
      "url": "/d/armor-restore",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Scheduler & Agent",
      "type": "link",
      "url": "/d/armor-scheduler",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Process & Runtime",
      "type": "link",
      "url": "/d/armor-runtime",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Process",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(armor_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(armor_build_info, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "armor-.*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Armor",
      "options": {
        "mode": "markdown",
        "content": "**Start here.** Freshness and failures first; drill into **Backups** (where a run's time went), **Storage & Integrations** (is the target the cause), **Scheduler & Agent** (why a schedule did not run). Click a trace id in the logs or the Backups trace table to open the span waterfall in Tempo."
      },
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Time since last successful backup",
      "description": "Seconds since the newest successful backup any selected process has seen (seeded from the database at startup).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 172800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(armor_backup_last_success_timestamp_seconds{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      }
    },
    {
      "type": "stat",
      "title": "Backups succeeded (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(armor_backup_jobs_total{job=~\"$job\",armor_outcome=\"success\"}[24h]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 2
      }
    },
