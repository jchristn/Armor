          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(armor_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(armor_build_info, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "armor-.*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
