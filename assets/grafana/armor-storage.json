{
  "uid": "armor-storage",
  "title": "Armor / Storage & Integrations",
  "description": "Every call to a storage target (disk, S3, Azure Blob, Google Cloud, CIFS, NFS), plus key operations and disaster recovery. Tells you whether the downstream is the cause.",
  "tags": [
    "armor",
    "storage",
    "integrations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Armor / Overview",
      "type": "link",
      "url": "/d/armor-overview",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Backups",
      "type": "link",
      "url": "/d/armor-backups",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Restore, Verify & Retention",
      "type": "link",
      "url": "/d/armor-restore",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Scheduler & Agent",
      "type": "link",
      "url": "/d/armor-scheduler",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Process & Runtime",
      "type": "link",
      "url": "/d/armor-runtime",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Process",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(armor_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(armor_build_info, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "armor-.*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Storage targets",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Operations by target and operation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (armor_storage_type, armor_storage_operation) (rate(armor_storage_operations_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{armor_storage_type}} {{armor_storage_operation}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
