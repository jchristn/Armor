{
  "uid": "armor-runtime",
  "title": "Armor / Process & Runtime",
  "description": ".NET runtime and process metrics for each Armor process (from the exporter's runtime instrumentation).",
  "tags": [
    "armor",
    "runtime",
    "process"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Armor / Overview",
      "type": "link",
      "url": "/d/armor-overview",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Backups",
      "type": "link",
      "url": "/d/armor-backups",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
    },
    {
      "title": "Armor / Storage & Integrations",
      "type": "link",
      "url": "/d/armor-storage",
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": ""
